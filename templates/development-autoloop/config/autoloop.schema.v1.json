{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autoloop.schema.v1.json",
  "title": "Development Autoloop configuration",
  "description": "Version 1 configuration contract. The local validator supports the schema keywords used in this document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "enabled",
    "defaultBranch",
    "runMode",
    "workProvider",
    "reviewProvider",
    "maxConcurrentSessions",
    "humanReadinessRequired",
    "automaticMerge",
    "scheduleEnabled",
    "requiredConfirmation",
    "staleClaimMinutes",
    "labels",
    "requiredIssueSections",
    "requiredChecks",
    "trustedReviewers",
    "sequenceSource"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "enabled": { "type": "boolean" },
    "defaultBranch": { "type": "string", "minLength": 1 },
    "runMode": { "type": "string", "enum": ["dry-run", "live"] },
    "workProvider": { "type": "string", "minLength": 1 },
    "reviewProvider": { "type": "string", "minLength": 1 },
    "maxConcurrentSessions": { "type": "integer", "minimum": 1 },
    "humanReadinessRequired": { "type": "boolean" },
    "automaticMerge": { "type": "boolean" },
    "scheduleEnabled": { "type": "boolean" },
    "requiredConfirmation": { "type": "string", "minLength": 1 },
    "staleClaimMinutes": { "type": "integer", "minimum": 1 },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposed",
        "ready",
        "claimed",
        "inProgress",
        "awaitingReview",
        "changesRequested",
        "approved",
        "blocked",
        "escalated"
      ],
      "properties": {
        "proposed": { "type": "string", "minLength": 1 },
        "ready": { "type": "string", "minLength": 1 },
        "claimed": { "type": "string", "minLength": 1 },
        "inProgress": { "type": "string", "minLength": 1 },
        "awaitingReview": { "type": "string", "minLength": 1 },
        "changesRequested": { "type": "string", "minLength": 1 },
        "approved": { "type": "string", "minLength": 1 },
        "blocked": { "type": "string", "minLength": 1 },
        "escalated": { "type": "string", "minLength": 1 }
      }
    },
    "requiredIssueSections": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "requiredChecks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "trustedReviewers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "sequenceSource": {
      "type": ["string", "null"],
      "minLength": 1
    }
  }
}
